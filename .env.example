# Kopieren nach .env und Werte eintragen:
#   cp .env.example .env

SECRET_KEY=bitte-langes-zufalliges-geheimnis-setzen
HOST=0.0.0.0
PORT=8080
DEBUG=0

# Täglicher Scan nach US-Börsenschluss
SCAN_TIMEZONE=Europe/Berlin
SCAN_HOUR=22
SCAN_MINUTE=30

# Telegram (BotFather -> Token, dann Chat-ID z. B. via @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional zusätzlich oder stattdessen Discord
DISCORD_WEBHOOK_URL=

# Filter (Defaults entsprechen der Spezifikation)
MIN_GROSS_MARGIN=0.35
MIN_ROE=0.15
MAX_DEBT_TO_EQUITY=1.5
MAX_PE_FALLBACK=28
